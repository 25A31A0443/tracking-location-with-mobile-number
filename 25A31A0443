#include <stdio.h>

int main() {
    double latitude, longitude;

    printf("Enter latitude: ");
    scanf("%lf", &latitude);

    printf("Enter longitude: ");
    scanf("%lf", &longitude);

    printf("Location received:\n");
    printf("Latitude: %lf\n", latitude);
    printf("Longitude: %lf\n", longitude);

    return 0;
}
