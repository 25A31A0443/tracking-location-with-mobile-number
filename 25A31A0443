/*
    Simple Phone Number Info Lookup in C
    -----------------------------------
    Requirements:
      - libcurl
      - cJSON

    Ubuntu/Debian:
      sudo apt install libcurl4-openssl-dev libcjson-dev

    Compile:
      gcc phone_lookup.c -o phone_lookup -lcurl -lcjson

    Run:
      ./phone_lookup
*/

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <curl/curl.h>
#include <cjson/cJSON.h>

#define API_KEY "YOUR_API_KEY"

/*
   Get free API key from:
   https://numverify.com/
*/

struct Memory {
    char *response;
    size_t size;
};

static size_t write_callback(void *contents, size_t size, size_t nmemb, void *userp) {
    size_t realsize = size * nmemb;

    struct Memory *mem = (struct Memory *)userp;

    char *ptr = realloc(mem->response, mem->size + realsize + 1);
    if(ptr == NULL) {
        printf("Not enough memory\n");
        return 0;
    }

    mem->response = ptr;

    memcpy(&(mem->response[mem->size]), contents, realsize);

    mem->size += realsize;
    mem->response[mem->size] = '\0';

    return realsize;
}

int main() {
    CURL *curl;
    CURLcode res;

    char phone[64];

    printf("Enter phone number (with country code): ");
    scanf("%63s", phone);

    char url[512];

    snprintf(
        url,
        sizeof(url),
        "http://apilayer.net/api/validate?access_key=%s&number=%s",
        API_KEY,
        phone
    );

    struct Memory chunk;
    chunk.response = malloc(1);
    chunk.size = 0;

    curl_global_init(CURL_GLOBAL_ALL);

    curl = curl_easy_init();

    if(curl) {
        curl_easy_setopt(curl, CURLOPT_URL, url);

        curl_easy_setopt(curl, CURLOPT_WRITEFUNCTION, write_callback);

        curl_easy_setopt(curl, CURLOPT_WRITEDATA, (void *)&chunk);

        res = curl_easy_perform(curl);

        if(res != CURLE_OK) {
            fprintf(stderr, "curl error: %s\n", curl_easy_strerror(res));
        } else {

            cJSON *json = cJSON_Parse(chunk.response);

            if(json) {

                cJSON *valid = cJSON_GetObjectItem(json, "valid");
                cJSON *number = cJSON_GetObjectItem(json, "international_format");
                cJSON *country = cJSON_GetObjectItem(json, "country_name");
                cJSON *location = cJSON_GetObjectItem(json, "location");
                cJSON *carrier = cJSON_GetObjectItem(json, "carrier");
                cJSON *line_type = cJSON_GetObjectItem(json, "line_type");

                printf("\n===== RESULT =====\n");

                if(valid && cJSON_IsBool(valid)) {
                    printf("Valid: %s\n", cJSON_IsTrue(valid) ? "Yes" : "No");
                }

                if(number && cJSON_IsString(number)) {
                    printf("Number: %s\n", number->valuestring);
                }

                if(country && cJSON_IsString(country)) {
                    printf("Country: %s\n", country->valuestring);
                }

                if(location && cJSON_IsString(location)) {
                    printf("Location: %s\n", location->valuestring);
                }

                if(carrier && cJSON_IsString(carrier)) {
                    printf("Carrier: %s\n", carrier->valuestring);
                }

                if(line_type && cJSON_IsString(line_type)) {
                    printf("Line Type: %s\n", line_type->valuestring);
                }

                cJSON_Delete(json);

            } else {
                printf("Failed to parse JSON\n");
            }
        }

        curl_easy_cleanup(curl);
    }

    free(chunk.response);

    curl_global_cleanup();

    return 0;
}
